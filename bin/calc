#!/usr/bin/perl
use strict;
use warnings;
use bignum;
no warnings 'portable';   # >32bit literals warned by portable are OK with bignum
use Data::Dumper;

local $Data::Dumper::Useqq  = 1;   # escape non-printable bytes
local $Data::Dumper::Terse  = 1;   # no "$VAR1 ="
local $Data::Dumper::Indent = 0;   # no newline, no indentation

my $x = "@ARGV";
$x =~ s/[kK]i?[bB]?/*(1<<10)/g;
$x =~ s/[mM]i?[bB]?/*(1<<20)/g;
$x =~ s/[gG]i?[bB]?/*(1<<30)/g;
$x =~ s/[tT]i?[bB]?/*(1<<40)/g;
$x =~ s/[pP]i?[bB]?/*(1<<50)/g;
$x = eval $x;

if (!$x->is_int()) {
	printf "%s\n%s\n", $x->bdstr(), $x->bsstr();
	exit
}

$x = $x->as_int();
my $u64 = $x & 0xffffffffffffffff;
my $i64 = $u64 >> 63 ? -1 * (($u64 ^ 0xffffffffffffffff) + 1) : $u64;
my $u32 = $x & 0xffffffff;
my $i32 = $u32 >> 31 ? -1 * (($u32 ^ 0xffffffff) + 1) : $u32;
my ($set, $human, $bytes) = ("", "", "");
if ($x->is_positive()) {
	for (my $b = 0; $x >> $b; $b++) {
		if (($x >> $b) & 1) {
			$set = $b . " " . $set;
		}
	}
	for (my @s = ("", "Ki", "Mi", "Gi", "Ti"), my $i = 0; $i < 5; $i++) {
		$human = ($x >> $i * 10) % 1024 . $s[$i] . " " . $human;
	}
	$human = ($x >> 50) . "Pi " . $human;
	$bytes = Dumper($x->to_bytes());
}

printf "hex:      %s\n", $x->as_hex();
printf "decimal:  %s %s %s\n", $x->bdstr(), $x->bnstr(), $x->bestr();
printf "octal:    %s\n", $x->as_oct();
printf "string:   %s\n", $bytes if length $bytes;
printf "binary:   %s\n", $x->as_bin();
printf "bits set: %s\n", $set if length $set;
printf "64 bit:   %#x %u %d\n", $u64, $u64, $i64;
printf "32 bit:   %#x %u %d\n", $u32, $u32, $i32;
printf "human:    %s\n", $human if length $human;
