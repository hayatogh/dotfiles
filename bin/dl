#!/bin/bash
set -euo pipefail

pids=()
files=()

cleanup()
{
	local running i p f partials=()
	trap - INT TERM HUP

	running=" $(jobs -pr | tr '\n' ' ') "
	for i in "${!pids[@]}"; do
		p=${pids[i]}
		f=${files[i]}
		if [[ $running == *" $p "* ]]; then
			kill -9 "$p" &>/dev/null || true
			partials+=("$f")
		fi
	done
	wait || true
	rm -f -- "${partials[@]}"
	exit 2
}

download_one()
{
	local url=$1 file f
	file=${url%%[?#]*}
	file=${file##*/}
	if [[ -z $file ]]; then
		echo >&2 "Couldn't find file name from $url"
		return 1
	fi

	for f in "${files[@]}"; do
		if [[ $f == "$file" ]]; then
			echo >&2 "Skipping $url: $file is just downloaded"
			return 1
		fi
	done

	curl -fsSL --remove-on-error -o "$file" "$url" &
	pids+=($!)
	files+=("$file")
}

trap cleanup INT TERM HUP

ret=0
if (($#)); then
	while (($#)); do
		download_one "$1" || ret=1
		shift
	done
else
	while read -rep'URL: ' url && [[ -n $url ]]; do
		download_one "$url" || ret=1
	done
fi

for i in "${!pids[@]}"; do
	if wait "${pids[i]}"; then
		echo "${files[i]}"
	else
		ret=1
	fi
done
exit $ret
